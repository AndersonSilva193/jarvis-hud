+
+/** Traços de 24×24, no mesmo peso dos ícones do resto do HUD. */
+const ICONES: Record<IconeSonda, string> = {
+  onda: 'M2 12h2M6 8v8M10 5v14M14 9v6M18 7v10M22 12h-2',
